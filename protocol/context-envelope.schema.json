{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/klondikemarlen/omp-send-context/blob/main/protocol/context-envelope.schema.json",
  "title": "OMP Context Envelope",
  "description": "Semantic wire contract shared by context-source adapters and the local OMP bridge.",
  "type": "object",
  "required": ["version", "source", "prompt"],
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "enum": ["vscode", "firefox"]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
