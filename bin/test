#!/usr/bin/env node
import { spawn } from "node:child_process"
import { fileURLToPath } from "node:url"

const args = process.argv.slice(2)
if (args.length > 0 && (args.length !== 1 || args[0] !== "--typescript")) {
  console.error("Usage: node bin/test [--typescript]")
  process.exit(2)
}

const testFiles =
  args.length === 0 ? ["test/**/*.test.mjs", "test/**/*.test.ts"] : ["test/**/*.test.ts"]
const repositoryRoot = fileURLToPath(new URL("../", import.meta.url))
const child = spawn(process.execPath, ["--import", "tsx", "--test", ...testFiles], {
  cwd: repositoryRoot,
  stdio: "inherit",
})

child.on("error", (error) => {
  console.error(`Unable to start Node test runner: ${error.message}`)
  process.exitCode = 1
})

child.on("close", (code) => {
  process.exitCode = code ?? 1
})
